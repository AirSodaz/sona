  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
