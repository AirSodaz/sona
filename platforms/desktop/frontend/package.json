  "version": "0.10.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-tokens.mjs && vite",
    "build": "node scripts/build-tokens.mjs && tsc && vite build",
    "build:tokens": "node scripts/build-tokens.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest --run",
    "test:e2e": "playwright test",
    "tauri": "node ../scripts/tauri.js",
    "verify:tauri-bundle": "node ../scripts/verify-tauri-bundle.js"
  },
  "dependencies": {
