    "@lexical/html": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-log": "^2.10.2",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
